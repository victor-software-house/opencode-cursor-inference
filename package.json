{
	"name": "opencode-cursor-inference",
	"version": "0.0.0",
	"description": "Unofficial Cursor managed inference provider for OpenCode over InferenceService/RunInference.",
	"author": "Victor Araújo",
	"license": "MIT",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/plugin.mjs",
	"types": "./dist/plugin.d.mts",
	"exports": {
		".": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		},
		"./plugin": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		},
		"./provider": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "mise run verify"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24"
		},
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0 <2.0.0"
		}
	},
	"keywords": [
		"opencode",
		"opencode-plugin",
		"cursor",
		"provider",
		"inference",
		"ai-sdk"
	],
	"dependencies": {
		"@ai-sdk/provider": "3.0.8",
		"@bufbuild/protobuf": "2.14.1"
	},
	"peerDependencies": {
		"@opencode-ai/plugin": ">=1.18.27 <2"
	},
	"peerDependenciesMeta": {
		"@opencode-ai/plugin": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@bufbuild/protoc-gen-es": "2.14.1",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@limegrass/eslint-plugin-import-alias": "1.6.1",
		"@opencode-ai/plugin": "1.18.27",
		"@types/bun": "1.4.0",
		"@types/node": "26.4.1",
		"knip": "6.34.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "7.0.2"
	}
}
